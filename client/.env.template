# ── 客户端环境变量 ──
# 复制本文件为 .env 并填入真实值：cp .env.template .env

# REST API 基础地址（开发环境通过 Vite 代理，留空即可）
VITE_API_URL=

# Yjs WebSocket 地址（开发环境通过 Vite 代理）
VITE_YJS_URL=ws://localhost:5173/yjs

# A1/A2/A3 已接入，默认启用 Markdown 主页的列表/创建/删除请求。
# 连接旧版服务端时设为 false；修改后需重启/重建 Vite。正文编辑/预览/自动保存现已接入。
VITE_MARKDOWN_API_ENABLED=true
