# ── Docker Compose 环境变量 ──
# 复制为 .env 后按需修改：cp .env.example .env
# 不提供 .env 时 compose 使用下面括号里的默认值，可直接 `docker compose up --build`

# 宿主访问端口（本机 3001 被 `npm run dev` 占用时改成 8080）
APP_PORT=3001

# MongoDB 数据库名
DB_NAME=nexadoc

# JWT 密钥——生产环境务必替换为随机长字符串
JWT_SECRET=dev-secret-change-in-production

# CORS 白名单（同源单端口部署下设为应用自身地址即可）
CLIENT_ORIGIN=http://localhost:3001
